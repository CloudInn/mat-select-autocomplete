{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "module": "ES2022",
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "ES2022",
    "skipLibCheck": true,
    "types": [],
    "lib": [
      "ES2022",
      "dom"
    ],
    "paths": {
      "select-autocomplete": [
        "dist/select-autocomplete"
      ],
      "select-autocomplete/*": [
        "dist/select-autocomplete/*"
      ]
    }
  }
}